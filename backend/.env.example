# Copy to .env (same folder as this file, i.e. backend/) and fill in. Never commit .env.
# Lines starting with # are optional or unset. Leave secrets commented out until you have
# a real value: a blank "LLM_API_KEY=" is treated as a set (empty) key, not as missing.

# --- Application ---
APP_NAME=Complaint Filing Assistant
DEBUG=true
# Origin of the frontend dev server (used for CORS). No trailing slash.
FRONTEND_ORIGIN=http://localhost:5173

# --- Sessions ---
# Relative paths are resolved from backend/. Session files go in <STORAGE_DIR>/sessions/.
STORAGE_DIR=storage
# Sessions expire after this many hours of inactivity.
SESSION_EXPIRY_HOURS=24

# --- LLM ---
# Supported providers: openai, gemini
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Required for chat and draft generation. One key, for whichever provider is selected.
# LLM_API_KEY=your-key-here
LLM_TIMEOUT_SECONDS=30

# --- Pinecone (optional; retrieval reports "unavailable" until these are set) ---
# The index must use integrated embeddings (text in, Pinecone embeds it).
# PINECONE_API_KEY=your-key-here
# PINECONE_INDEX_NAME=your-index-name
# Leave unset to use Pinecone's default namespace.
# PINECONE_NAMESPACE=your-namespace